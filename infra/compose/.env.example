FIAR_PUBLIC_ORIGIN=https://fiar.internal.example
FIAR_ALLOWED_HOST=fiar.internal.example
FIAR_OIDC_ISSUER=https://identity.example
FIAR_OIDC_CLIENT_ID=replace-with-registered-client
FIAR_OIDC_AUDIENCE=replace-with-registered-audience
FIAR_OIDC_REDIRECT_URI=https://fiar.internal.example/v1/auth/oidc/callback
FIAR_DASHBOARD_PORT=8080
FIAR_POSTGRES_PASSWORD_FILE=/etc/fiar/secrets/postgres_password
FIAR_DATABASE_URL_FILE=/etc/fiar/secrets/database_url
FIAR_CREDENTIAL_PEPPER_FILE=/etc/fiar/secrets/credential_pepper
FIAR_SESSION_PEPPER_FILE=/etc/fiar/secrets/session_pepper
FIAR_CSRF_KEY_FILE=/etc/fiar/secrets/csrf_key
FIAR_OIDC_STATE_KEY_FILE=/etc/fiar/secrets/oidc_state_key
FIAR_OIDC_CLIENT_SECRET_FILE=/etc/fiar/secrets/oidc_client_secret
FIAR_METRICS_TOKEN_FILE=/etc/fiar/secrets/metrics_token
