FROM node:22-alpine AS build
WORKDIR /app
ARG VITE_FIAR_DASHBOARD_MODE=production
ENV VITE_FIAR_DASHBOARD_MODE=$VITE_FIAR_DASHBOARD_MODE
COPY package.json package-lock.json ./
COPY packages/sdk/package.json packages/sdk/package.json
RUN npm ci
COPY apps/dashboard apps/dashboard
COPY packages/sdk packages/sdk
RUN npm run dashboard:build

FROM nginx:1.27-alpine AS runtime
COPY infra/docker/nginx-dashboard.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/dashboard/dist /usr/share/nginx/html
RUN sed -i 's#^[[:space:]]*pid .*;#pid /tmp/nginx.pid;#' /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /usr/share/nginx/html /var/cache/nginx /var/run
USER nginx
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=4 CMD wget -q -O /dev/null http://127.0.0.1:8080/health/live || exit 1
