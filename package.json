{
  "name": "agent-authorization-firewall",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/sdk"
  ],
  "scripts": {
    "test": "tsx --test packages/shared/test/*.test.ts apps/gateway/test/policy.test.ts",
    "test:shared": "tsx --test packages/shared/test/*.test.ts",
    "test:policy": "tsx --test apps/gateway/test/policy.test.ts",
    "test:integration": "tsx --test apps/gateway/test/actions.test.ts apps/gateway/test/security.test.ts apps/gateway/test/approvals.test.ts apps/gateway/test/phase6.test.ts",
    "test:worker": "tsx --test apps/worker/test/*.test.ts",
    "test:sdk": "tsx --test packages/sdk/test/*.test.ts",
    "test:dashboard": "tsx --test apps/dashboard/test/*.test.ts",
    "dashboard:typecheck": "tsc --noEmit -p apps/dashboard/tsconfig.json",
    "dashboard:build": "vite build --config apps/dashboard/vite.config.ts",
    "dashboard:check": "npm run test:dashboard && npm run dashboard:typecheck && npm run dashboard:build",
    "build:gateway": "esbuild apps/gateway/src/server.ts apps/gateway/src/migrate.ts apps/gateway/src/admin-cli.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/gateway",
    "build:worker": "esbuild apps/worker/src/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/worker/server.mjs",
    "build:servers": "npm run build:gateway && npm run build:worker",
    "verify": "npm run typecheck && npm test && npm run test:integration && npm run test:worker && npm run test:sdk && npm run dashboard:check",
    "db:setup": "tsx apps/gateway/src/migrate.ts",
    "operator": "tsx apps/gateway/src/admin-cli.ts",
    "credential:create": "npm run operator -- credential-create",
    "credential:rotate": "npm run operator -- credential-rotate",
    "credential:revoke": "npm run operator -- credential-revoke",
    "identity:map": "npm run operator -- identity-map",
    "session:revoke": "npm run operator -- session-revoke",
    "hygiene": "node infra/scripts/check-repository-hygiene.mjs && node infra/scripts/check-markdown-links.mjs",
    "links": "node infra/scripts/check-markdown-links.mjs",
    "dev:gateway": "tsx apps/gateway/src/server.ts",
    "dev:worker": "tsx apps/worker/src/server.ts",
    "dev:dashboard": "vite --config apps/dashboard/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "jose": "^6.2.12",
    "pg": "^8.13.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
