{
  "name": "agent-authorization-firewall",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "tsx --test packages/shared/test/*.test.ts apps/gateway/test/policy.test.ts",
    "test:shared": "tsx --test packages/shared/test/*.test.ts",
    "test:policy": "tsx --test apps/gateway/test/policy.test.ts",
    "test:integration": "tsx --test apps/gateway/test/actions.test.ts apps/gateway/test/security.test.ts",
    "verify": "npm run typecheck && npm test && npm run test:integration",
    "db:setup": "tsx apps/gateway/src/migrate.ts",
    "dev:gateway": "tsx apps/gateway/src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.4.0",
    "pg": "^8.13.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.4",
    "typescript": "^5.9.2"
  }
}
